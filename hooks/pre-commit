#!/bin/bash
#
# Pre-commit hook for splintr
#
# Install by copying to .git/hooks/:
#   cp hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "Running pre-commit checks..."
echo ""

# Resolving through a local override rewrites Cargo.lock: `.cargo/config.toml`
# carries a `[patch.crates-io]` entry pointing regexr at a sibling checkout, and
# the patched crate then loses its registry `source` and `checksum` and becomes a
# bare path entry. That form is useless to anyone without the same directory
# layout, and `--locked` builds and `cargo publish` reject it.
#
# Anything that runs cargo does this, including rust-analyzer in the background,
# so restoring the file after the checks below is not enough — the damage can
# land before the commit is even staged. What is staged is what gets checked.
LOCK_BACKUP=""
restore_lock() {
    if [ -n "$LOCK_BACKUP" ]; then
        cp "$LOCK_BACKUP" Cargo.lock
        rm -f "$LOCK_BACKUP"
    fi
}
if [ -f Cargo.lock ]; then
    LOCK_BACKUP="$(mktemp)"
    cp Cargo.lock "$LOCK_BACKUP"
    trap restore_lock EXIT
fi

FAILED=0

# 0. Staged Cargo.lock carries no path-resolved dependency
if git diff --cached --name-only | grep -qx "Cargo.lock"; then
    echo -n "Checking staged Cargo.lock... "
    # A package with no `source` is either one of this repo's own crates or a
    # dependency that resolved through the override. Only the former is legitimate.
    PATCHED=$(git show :Cargo.lock | awk '
        /^\[\[package\]\]/ { name=""; has_source=0; next }
        /^name = / { gsub(/"/, "", $3); name=$3; next }
        /^source = / { has_source=1; next }
        /^$/ { if (name != "" && !has_source) print name; name=""; next }
        END { if (name != "" && !has_source) print name }
    ' | grep -vx "splintr" || true)

    if [ -n "$PATCHED" ]; then
        echo -e "${RED}FAILED${NC}"
        echo -e "${YELLOW}Resolved through the local override:${NC} $(echo "$PATCHED" | tr '\n' ' ')"
        echo -e "${YELLOW}Re-resolve against the registry with:${NC}"
        echo "    mv .cargo/config.toml .cargo/config.toml.bak"
        echo "    cargo fetch"
        echo "    mv .cargo/config.toml.bak .cargo/config.toml"
        echo "    git add Cargo.lock"
        FAILED=1
    else
        echo -e "${GREEN}OK${NC}"
    fi
fi

# 1. Rust formatting
echo -n "Checking formatting... "
if ! cargo fmt --all --check > /dev/null 2>&1; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${YELLOW}Fix with:${NC} cargo fmt --all"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 2. Clippy
echo -n "Running clippy... "
if ! cargo clippy --all-targets -- -D warnings > /dev/null 2>&1; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${YELLOW}Run:${NC} cargo clippy --all-targets"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 3. Tests
#
# nextest when it is installed, because `.config/nextest.toml` is where the two
# wall-clock tests are given the machine to themselves and a retry. `cargo test`
# ignores that file, so under it those two race the rest of the suite for the
# cores they are measuring and fail on a busy machine with nothing wrong.
echo -n "Running tests... "
if command -v cargo-nextest > /dev/null 2>&1; then
    # nextest has no `--quiet`; its own status line goes to stderr, which is
    # already discarded below.
    TEST_CMD="cargo nextest run"
else
    TEST_CMD="cargo test --quiet"
fi
if ! $TEST_CMD > /dev/null 2>&1; then
    echo -e "${RED}FAILED${NC}"
    echo -e "${YELLOW}Run:${NC} $TEST_CMD"
    FAILED=1
else
    echo -e "${GREEN}OK${NC}"
fi

# 4. Update uv.lock if pyproject.toml changed
if git diff --cached --name-only | grep -q "pyproject.toml"; then
    echo -n "Updating uv.lock... "
    if ! uv lock > /dev/null 2>&1; then
        echo -e "${RED}FAILED${NC}"
        echo -e "${YELLOW}Run:${NC} uv lock"
        FAILED=1
    else
        git add uv.lock
        echo -e "${GREEN}OK${NC}"
    fi
fi

echo ""

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}Pre-commit checks failed.${NC}"
    echo "Bypass with: git commit --no-verify"
    exit 1
fi

echo -e "${GREEN}All checks passed!${NC}"
